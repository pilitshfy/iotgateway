{
  "$schema": "https://gitee.com/dotnetchina/Furion/raw/v4/schemas/v4/furion-schema.json",

  "ConfigurationScanDirectories": [ "Configuration", "" ], // 扫描配置文件json文件夹（自动合并该文件夹里面所有json文件）

  // IoT 时序历史存储（TimescaleDB，PostgreSQL 扩展）
  "IotHistory": {
    "Enabled": true,
    "ConnectionString": "Host=127.0.0.1;Port=5432;Database=iotgateway_ts;Username=iotgateway;Password=IotGateway@2026",
    "BatchSize": 500,
    "FlushIntervalMs": 1000,
    "RetentionDays": 30
  },

  // 采集运行时多实例静态分片：同一套程序与配置库，按实例分配分片
  // Enabled=false 表示本实例仅提供 API 不采集；ShardCount=1 表示单实例采集全部设备
  "IotCollector": {
    "Enabled": true,
    "ShardIndex": 0,
    "ShardCount": 1,
    "SyncSeconds": 30
  },

  // 汇聚总线 Kafka 双通道（与 MQTT 并列；关闭时不影响 MQTT 通道）
  "Kafka": {
    "Enabled": false,
    "BootstrapServers": "127.0.0.1:9092",
    "ConsumerGroup": "iotgateway-ingest",
    "IngestTopic": "iot.edge.ingest",
    "ForwardEnabled": false,
    "ForwardTopic": "iot.telemetry"
  }
}